
   classDiagram
    class Owner {
        +first_name: str
        +last_name: str
        +available_minutes: int
        +pets: List~Pet~
        +add_pet(pet: Pet): None
        +get_all_tasks(): List~Tuple~Pet, Task~~
    }

    class Pet {
        +name: str
        +species: str
        +breed: str
        +age: int
        +tasks: List~Task~
        +add_task(task: Task): None
    }

    class Task {
        +description: str
        +due_date: date
        +time: str (HH:MM)
        +duration_minutes: int
        +priority: str (high/medium/low)
        +frequency: str (once/daily/weekly)
        +is_completed: bool
        +mark_complete(): None
    }

    class Scheduler {
        +owner: Owner
        +sort_by_time(): List~Tuple~Pet, Task~~
        +filter_tasks(pet_name=None, is_completed=None): List~Tuple~Pet, Task~~
        +detect_conflicts()
        +generate_daily_plan(): List~Tuple~Pet, Task~~
        +mark_task_complete(pet: Pet, task: Task): None
    }

    Owner "1" --> "0..*" Pet : has
    Pet "1" --> "0..*" Task : has
    Scheduler --> "1" Owner : retrieves tasks via get_all_tasks()